      "name": "Labelled Switch Row",
      "kind": "custom",
      "refersTo": "switch-row",
      "description": "A single focusable switch target with visible label and description.",
      "html": "<button class=\"ds-switch-row\" role=\"switch\" aria-checked=\"true\"><span class=\"ds-switch-copy\"><span class=\"ds-switch-label\">High contrast</span><span class=\"ds-switch-detail\">Make text and borders stronger.</span></span><span class=\"ds-switch-track\" aria-hidden=\"true\"><span class=\"ds-switch-thumb\"></span></span></button>",
      "css": ".ds-switch-row{font-family:'Zen Kaku Gothic New',sans-serif;display:flex;align-items:center;gap:16px;min-height:56px;padding:12px;border:2px solid #718578;border-radius:12px;background:#FFFFFF;color:#202923;text-align:left;cursor:pointer}.ds-switch-copy{display:grid;gap:4px;flex:1}.ds-switch-label{font-size:19px;line-height:30px;font-weight:700}.ds-switch-detail{font-size:17px;line-height:27px;font-weight:500;color:#506358}.ds-switch-track{display:block;width:48px;height:28px;border-radius:20px;background:#718578;flex-shrink:0;padding:2px}.ds-switch-thumb{display:block;width:24px;height:24px;background:#FFFFFF;border-radius:50%}.ds-switch-row[aria-checked=\"true\"] .ds-switch-track{background:#235A46}.ds-switch-row[aria-checked=\"true\"] .ds-switch-thumb{margin-left:24px}.ds-switch-row:hover{cursor:pointer}.ds-switch-row:focus-visible{border-color:#235A46;outline:3px solid #235A46;outline-offset:3px;}.ds-switch-row:active{border-color:#235A46}.ds-switch-row:disabled{cursor:default}"
    },
    {
      "name": "Status Banner",
      "kind": "custom",
      "refersTo": "status-info",
      "description": "Polite informational or success notice with icon and supporting text.",
      "html": "<div class=\"ds-status\" role=\"status\"><svg class=\"ds-status-icon\" aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 11v6M12 7h.01\"/></svg><div class=\"ds-status-copy\"><strong class=\"ds-status-title\">Your choice is saved</strong><p class=\"ds-status-body\">You can change it when you are ready.</p></div></div>",
      "css": ".ds-status{font-family:'Zen Kaku Gothic New',sans-serif;display:flex;align-items:flex-start;gap:12px;padding:24px;border-radius:16px;background:#E3EFE7;color:#235A46}.ds-status-icon{flex-shrink:0}.ds-status-copy{display:grid;gap:8px;min-width:0}.ds-status-title{font-size:19px;line-height:30px;font-weight:700}.ds-status-body{margin:0;font-size:19px;line-height:30px;color:#202923}"
    },
    {
      "name": "Reading Settings Dialog",
      "kind": "custom",
      "refersTo": "dialog",
      "description": "Visual preview of the shared scrollable modal. The application component supplies focus containment and preference behavior.",
      "html": "<div class=\"ds-dialog-scrim\"><section class=\"ds-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ds-reading-title\"><h2 class=\"ds-dialog-title\" id=\"ds-reading-title\">Reading settings</h2><p class=\"ds-dialog-body\">Choose the text size that feels comfortable.</p><div class=\"ds-dialog-choices\"><button class=\"ds-dialog-choice\">Normal</button><button class=\"ds-dialog-choice\" aria-pressed=\"true\">Large</button><button class=\"ds-dialog-choice\">Extra Large</button></div><button class=\"ds-dialog-close\">Close</button></section></div>",
      "css": ".ds-dialog-scrim{display:flex;align-items:center;justify-content:center;background:rgba(32,41,35,.48);padding:16px}.ds-dialog{font-family:'Zen Kaku Gothic New',sans-serif;width:100%;max-width:560px;max-height:100%;overflow:auto;display:grid;gap:24px;padding:24px;border-radius:20px;background:#FFFFFF;color:#202923}.ds-dialog-title{margin:0;font-size:23px;line-height:34px;font-weight:700}.ds-dialog-body{margin:0;font-size:19px;line-height:30px}.ds-dialog-choices{display:grid;gap:12px}.ds-dialog-choice,.ds-dialog-close{font-family:'Zen Kaku Gothic New',sans-serif;font-size:19px;line-height:28px;font-weight:700;min-height:56px;min-width:48px;padding:12px 24px;border:2px solid #718578;border-radius:12px;background:#FFFFFF;color:#202923;cursor:pointer;white-space:normal}.ds-dialog-choice[aria-pressed=\"true\"]{background:#E3EFE7;border-color:#235A46}.ds-dialog-choice:hover,.ds-dialog-close:hover{cursor:pointer}.ds-dialog-choice:focus-visible,.ds-dialog-close:focus-visible{outline:3px solid #235A46;outline-offset:3px;}.ds-dialog-choice:active,.ds-dialog-close:active{background:#E3EFE7}"
    }
  ],
  "narrative": {
    "northStar": "A Welcoming Home",
    "overview": "Warm, readable and calm: KAKEHASHI uses ivory surroundings, white cards, sage notes and deep-green actions to help an older adult understand the next useful choice. Rounded rectangles and restrained shadows give controls a familiar, welcoming character. English and Japanese share a spacious hierarchy.\n\nThe older adult's autonomy shapes visual emphasis. Actions, consent and the option to defer remain readable and named. Shared reading preferences adapt the interface without taking the user away from the current task.",
    "keyCharacteristics": [
      "Large, wrapping text with labelled actions.",
      "Warm surfaces and clear dark foregrounds.",
      "Gentle corners and restrained card depth.",
      "Reading preferences shared across roles."
    ],
    "rules": [
      {
        "name": "The Readable Surface Rule",
        "body": "Use dark text on sage and peach. Keep light text for deep-green fills.",
        "section": "colors"
      },
      {
        "name": "The Meaning Stays Rule",
        "body": "Preserve the separate decision-color mapping and its labels when migrating screens.",
        "section": "colors"
      },
      {
        "name": "The Reading First Rule",
        "body": "Let text wrap and increase control height; do not clamp important shared action labels to a fixed single line.",
        "section": "typography"
      },
      {
        "name": "The Fit Must Fit Rule",
        "body": "Use the full wide-eligibility condition before choosing a fitted or two-column layout; readable text takes precedence over fitting a desktop composition.",
        "section": "layout"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use the shared card shadow for ordinary white cards and tonal layering for sage surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** build shared reading content with AppText and palette-aware components.",
      "**Do** keep clear labels alongside icons and allow English and Japanese text to wrap.",
      "**Do** honor OS scaling and reduced motion in addition to the app preferences.",
      "**Do** preserve consent, deferral, family-wish labels and existing routes when migrating presentation.",
      "**Do** use the complete wide-eligibility condition and permit vertical scrolling at larger text sizes.",
      "**Do** validate native devices and screen readers before claiming native accessibility coverage."
    ],
    "donts": [
      "**Don't** put pale text on sage or peach surfaces.",
      "**Don't** use fixed-height text containers that clip enlarged shared action labels.",
      "**Don't** turn static pills into unlabelled interactive controls.",
      "**Don't** claim all legacy text is adjustable or all raw controls meet the shared target minima.",
      "**Don't** claim native preference persistence, dark appearance, device integration or legacy 3D reduced-motion support is implemented.",
      "**Don't** treat web screenshots or source semantics as completed VoiceOver, TalkBack or native OS-scaling tests."
    ]
  }
}
