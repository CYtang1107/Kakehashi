# Copy this file to .env and fill in what you have. Never commit .env.

# Port the API listens on.
PORT=4100

# AI value estimates. Without a key the server uses a simple offline estimate.
# Create a key at https://console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=

# Payments. Use a Stripe TEST secret key only (starts with sk_test_).
# Live keys are refused. Without a key, checkout runs in demo mode (no charge).
STRIPE_SECRET_KEY=
