{
  "name": "kakehashi",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,app -c blue,green \"npm run dev -w apps/server\" \"npm run start -w apps/mobile\"",
    "server": "npm run dev -w apps/server",
    "app": "npm run start -w apps/mobile",
    "reset": "curl -s -X POST http://localhost:4100/api/reset"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "overrides": {
    "react-native": "0.86.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
